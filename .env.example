# Copy to .env (never commit .env). The values in .env win over variables already exported in your shell.

# Required. Use a dedicated key for this spike so its cost and rate limits stay separate.
ANTHROPIC_API_KEY=

# Required. A Hardwood agent key (ctnba_...), created with `npm run create-api-key` in the Hardwood repo.
HARDWOOD_API_KEY=

# Hardwood backend-api. Defaults to the deployed Railway service from the Hardwood README.
HARDWOOD_BASE_URL=https://backend-api-production-f05a.up.railway.app

# Optional
# MODEL=claude-sonnet-5-5
# MAX_TOKENS=16000
# PROMPT_CACHE=true
# EFFORT=          # low | medium | high | xhigh | max (empty = API default, high)
# THINKING=adaptive  # adaptive | off
# MAX_COST_USD=1.0
# MAX_SECONDS=300
# Web searches allowed per question (0 turns web search off). Each search is billed on top of tokens.
# WEB_SEARCH_MAX_USES=4
# WEB_SEARCH_TOOL_TYPE=web_search_20250305
# JSONL log of questions, tool calls, timings and token counts. Empty value disables it.
# CHAT_LOG=logs/chat.jsonl
# SQLite file for the props dashboard (default data/props.db)
# DB_PATH=data/props.db
# Collection schedule for the props dashboard (minutes unless noted)
# COLLECT_EARLY_MIN=120        early in the day: refresh the board this often
# COLLECT_ACTIVE_MIN=30        inside a game's pre-tip window: refresh this often, until tip-off
# COLLECT_WINDOW_HOURS=3       how long before tip-off the pre-tip window opens
# COLLECT_SETTLE_MIN=60        after tip-off: only to pick up final scores and results
# COLLECT_RETRY_MIN=10         retry a failed collection after this long

# Prospective validation ledger (docs/PROSPECTIVE_OPERATIONS.md). Off by default; turn on only on the machine that stays awake and online.
# LEDGER_ENABLED=false
# LEDGER_PATH=data/ledger/ledger.db
# LEDGER_MIRROR_DIR=data/ledger/mirror
